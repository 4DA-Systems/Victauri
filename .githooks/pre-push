#!/bin/bash
# local pre-push gate (generalized — cargo, node, or mixed repos). Replaces reliance on hosted
# GitHub Actions for private-repo pushes: runs the repo's real gate locally at $0.
#
#   GATE 1 — committed-tree COHERENCE of the tree you are PUSHING (not the working dir), per stack:
#            cargo repos → `cargo metadata`; node repos → package.json parses. Catches the "green locally,
#            garbage in the commit" corruption class (the PR #78 graft). Skipped only if neither manifest exists.
#   GATE 2 — FUNCTIONAL gate: `gate-runner pipeline .gate/gate.json` (skip-cached, bounded-parallel; stack-agnostic).
#
# ENFORCEMENT (the gap this version closes): if the functional gate cannot RUN (no pipeline-capable gate found),
# the default is fail-OPEN with a LOUD notice — but set **LOCAL_GATE_REQUIRE=1** to fail-CLOSED (block the push)
# so a missing binary can never silently let an UN-GATED push through. Pick fail-open for convenience, REQUIRE
# for guaranteed enforcement.
#   BYPASS: `git push --no-verify` (git-native) or `LOCAL_GATE_SKIP=1`.
#
# SECURITY SCOPE: GATE 2 runs `cargo clippy`/`cargo test` on the WORKING TREE, which COMPILES it (build.rs +
# proc-macros + test code execute). The install-time integrity pin protects THIS script + gate.json from
# branch tampering, but running the gate on a hostile checked-out branch is still arbitrary code execution by
# construction. This gate is for pushing code you authored/trust — not a sandbox for untrusted branches.
set -u
REQUIRE="${LOCAL_GATE_REQUIRE:-0}"
[ "${LOCAL_GATE_SKIP:-0}" = "1" ] && { echo "[local-gate] bypassed (LOCAL_GATE_SKIP=1)"; exit 0; }
PUSH_REFS="$(cat 2>/dev/null || true)"   # stdin consumable once — capture before anything reads it
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

# ---- GATE 0: private-asset leak scan ----
# Block pushing any outgoing commit (message OR content) that names the private external verifier. Backstops
# the 2026-07-13 public scrub: this repo is UNPROTECTED, so a local hook is the only re-leak defense, and a
# branch based on PRE-SCRUB history would otherwise re-upload the old commits. Detection is HASHED inline (no
# literal name lives in this file). FAIL-OPEN on any tool error — never brick pushes; block ONLY on a positive
# detection. Here-string (not a pipe) so `exit` propagates out of the loop. Bypass: git push --no-verify.
if command -v node >/dev/null 2>&1 && [ -n "$PUSH_REFS" ]; then
  Z0="0000000000000000000000000000000000000000"
  while read -r g_lref g_lsha g_rref g_rsha; do
    [ -n "${g_lsha:-}" ] || continue
    [ "$g_lsha" = "$Z0" ] && continue
    if [ "${g_rsha:-$Z0}" = "$Z0" ]; then
      g_om="$(git rev-parse -q --verify origin/main 2>/dev/null)" && g_ar="$g_om..$g_lsha" || g_ar="$g_lsha"
    else
      g_ar="$g_rsha..$g_lsha"
    fi
    if git log -p -n 2000 --no-color "$g_ar" 2>/dev/null | node -e 'const c=require("crypto");const H=new Set(["3b01fbd96a4eb7b550f483723ce5db19970af945b91930a224f78717a7023ad2","344ceb6cff3675fc2ce7e5f83158d83ca9d8f45567f6313d8b9ae34aefdaae01"]);let s="";process.stdin.on("data",d=>s+=d);process.stdin.on("end",()=>{try{for(const t of s.split(/[^A-Za-z0-9]+/)){const x=t.toLowerCase();if(x.length>=4&&H.has(c.createHash("sha256").update(x).digest("hex"))){process.exit(1)}}process.exit(0)}catch(e){process.exit(0)}})'; then :; else
      echo ""
      echo "[local-gate] PUSH BLOCKED — outgoing commits on ${g_lref:-?} name the private external verifier."
      echo "[local-gate]   Likely a branch based on PRE-SCRUB history. Rebase onto origin/main, then re-push:"
      echo "[local-gate]   git fetch origin && git rebase --onto origin/main \$(git merge-base HEAD <old-base>) HEAD"
      exit 1
    fi
  done <<< "$PUSH_REFS"
fi

# ---- GATE 1: committed-tree coherence (stack-aware) ----
have_cargo=0; have_node=0
[ -f "$ROOT/Cargo.toml" ] && have_cargo=1
[ -f "$ROOT/package.json" ] && have_node=1
if { [ $have_cargo = 1 ] || [ $have_node = 1 ]; } && command -v tar >/dev/null 2>&1 && [ -n "$PUSH_REFS" ]; then
  ZERO="0000000000000000000000000000000000000000"
  while read -r lref lsha rref rsha; do
    [ -n "${lsha:-}" ] || continue
    [ "$lsha" = "$ZERO" ] && continue
    work="$(mktemp -d 2>/dev/null)" || continue
    if git archive "$lsha" 2>/dev/null | tar -x -C "$work" 2>/dev/null; then
      ok=1
      if [ $have_cargo = 1 ] && command -v cargo >/dev/null 2>&1; then
        ( cd "$work" && cargo metadata --no-deps --format-version 1 >/dev/null 2>&1 ) || ok=0
      fi
      if [ $ok = 1 ] && [ $have_node = 1 ] && command -v node >/dev/null 2>&1; then
        node -e "JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'))" "$work/package.json" >/dev/null 2>&1 || ok=0
      fi
      if [ $ok = 0 ]; then
        rm -rf "$work"
        echo "[local-gate] GATE 1 FAIL — committed tree $lsha is NOT coherent (manifest missing/unparseable: the corruption class)."
        echo "[local-gate]   Inspect: git ls-tree -r $lsha | head   ·   Bypass: git push --no-verify"
        exit 1
      fi
    fi
    rm -rf "$work"
  done <<< "$PUSH_REFS"
  echo "[local-gate] GATE 1: committed-tree coherence OK"
fi

# ---- GATE 2: functional gate via gate-runner pipeline ----
SPEC="$ROOT/.gate/gate.json"
[ -f "$SPEC" ] || { echo "[local-gate] no .gate/gate.json — functional gate not configured (push allowed)"; exit 0; }
GATE=""
for cand in "${LOCAL_GATE_BIN:-}" "$(command -v gate-runner 2>/dev/null || true)" \
            "/d/dev-cache/.cargo/bin/gate-runner.exe" "/d/dev-cache/.cargo/bin/gate-runner.exe" \
            "$ROOT/target/release/gate-runner.exe" "$ROOT/target/debug/gate-runner.exe"; do
  [ -n "$cand" ] || continue
  if "$cand" pipeline --help >/dev/null 2>&1; then GATE="$cand"; break; fi
done
if [ -z "$GATE" ]; then
  if [ "$REQUIRE" = "1" ]; then
    echo "[local-gate] BLOCKED — no pipeline-capable gate found and LOCAL_GATE_REQUIRE=1 (strict). The gate could"
    echo "[local-gate]   not run, so this UN-GATED push is refused. Build/stage gate, or bypass: git push --no-verify"
    exit 1
  fi
  echo "[local-gate] ⚠ no pipeline-capable gate found — functional gate did NOT run, push allowed (FAIL-OPEN)."
  echo "[local-gate]   This push was NOT functionally verified. Set LOCAL_GATE_REQUIRE=1 to enforce (fail-closed)."
  exit 0
fi
echo "[local-gate] GATE 2: local functional gate ($GATE; skip-cached; bypass: git push --no-verify) ..."
if "$GATE" pipeline --spec "$SPEC" --cwd "$ROOT"; then
  echo "[local-gate] PASS — push allowed"; exit 0
fi
echo "[local-gate] FAIL — push BLOCKED. Fix the gate, or bypass with: git push --no-verify"
exit 1
